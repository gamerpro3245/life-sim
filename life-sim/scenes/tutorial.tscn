[node name="TextLabel" type="Label" parent="Center/Box" unique_id=599393826]
custom_minimum_size = Vector2(440, 0)
layout_mode = 2
text = "    Ты живёшь в маленьком доме. Следи за потребностями слева вверху и выполняй цели дня справа внизу: за каждую даются деньги.

    Ходить: стрелки или WASD
    Использовать предмет: E
    Меню паузы: Esc

    Кровать — сон, холодильник — еда (стоит денег), умывальник — гигиена, стол — работа, пианино и полка — развлечение.

    Хорошее настроение: ходишь быстрее и больше зарабатываешь."
autowrap_mode = 2

[node name="StartButton" type="Button" parent="Center/Box" unique_id=1375013344]
